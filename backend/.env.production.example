# SombaTeka — Variables d'environnement PRODUCTION
# Copier vers .env.production et remplir TOUTES les valeurs marquées REQUIRED.
# Ne jamais committer .env.production avec de vrais secrets.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
PUBLIC_BASE_URL=https://sombatekaonline.com

# IndexNow (Bing/Yandex) — ping auto à chaque publication. Google Search n'a pas d'équivalent produit.
INDEXNOW_ENABLED=true
INDEXNOW_KEY=8f3c2a1b9e7d4c6a5b0f1e2d3c4b5a6978

# Google Merchant Center (listings Shopping gratuits — pas Ads)
# Étape 1 : brancher le feed URL dans Merchant Center (suffisant pour démarrer)
# Étape 2 (optionnel) : Content API temps réel — voir docs/GOOGLE_MERCHANT_CENTER.md
GOOGLE_MERCHANT_ENABLED=true
GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_TARGET_COUNTRY=CD
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON=
GOOGLE_MERCHANT_SERVICE_ACCOUNT_FILE=

# REQUIRED — mot de passe PostgreSQL (utilisé aussi par docker-compose)
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

DATABASE_URL=postgresql+psycopg://sombateka:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/sombateka_prod

# REQUIRED — secret JWT 64+ caractères aléatoires
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ISSUER=sombateka-prod
JWT_AUDIENCE=sombateka-mobile-prod
# REQUIRED en prod : 15–120 minutes (jamais 7 jours)
ACCESS_TOKEN_MINUTES=60

# REQUIRED — mot de passe Redis (réseau Docker interne)
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
USE_REDIS_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=60

# ── Sécurité ──────────────────────────────────────────────────────────────────
ALLOW_DEV_PASSWORD_LOGIN=false
DEV_LOGIN_PASSWORD=
EXPOSE_OTP_IN_RESPONSE=false
AUTO_CREATE_TABLES=false
SEED_DEV_DATA=false
PAYMENT_SANDBOX_MODE=false
# Paiement in-app (Mobile Money). false jusqu'à OOO + clés opérateurs.
PAYMENTS_ENABLED=false

# REQUIRED — mot de passe panneau admin /admin
ADMIN_PANEL_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_MINUTES=120
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Optionnel : restreindre /admin à tes IPs (vide = public + auth + rate limit)
# Exemple: ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.20
ADMIN_IP_ALLOWLIST=

# REQUIRED — domaines autorisés (app web, admin)
CORS_ORIGINS=https://sombatekaonline.com,https://www.sombatekaonline.com

# SMS OTP désactivé en prod — email / Google / Apple uniquement
ALLOW_PHONE_OTP=false
SMS_API_KEY=CHANGE_ME
SMS_USERNAME=CHANGE_ME
SMS_SENDER_ID=SombaTeka

# ── Email (Resend recommandé en prod) ─────────────────────────────────────────
# Provider : log | smtp | resend
EMAIL_PROVIDER=resend
EMAIL_FROM=SombaTeka <noreply@sombatekaonline.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ADMIN_ALERT_EMAILS=ops@example.com,support@example.com

# ── Mobile Money ──────────────────────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=5.0
PAYOUT_DELAY_HOURS=24
ESCROW_DELIVERY_HOURS=48
REPORTS_AUTO_HIDE_THRESHOLD=3

MTN_MONEY_API_URL=
MTN_MONEY_API_KEY=
MTN_MONEY_API_SECRET=
MTN_MONEY_SUBSCRIPTION_KEY=
MTN_MONEY_CALLBACK_SECRET=

ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_CALLBACK_SECRET=

# Webhooks à enregistrer chez les opérateurs :
#   https://api.sombateka.cd/api/webhooks/mtn
#   https://api.sombateka.cd/api/webhooks/orange

# ── Stockage images (optionnel — local ./uploads si vide) ─────────────────────
# Si S3/Spaces configuré : S3_PUBLIC_BASE_URL peut être omis (déduit auto pour DO Spaces).
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=sombateka-uploads
S3_REGION=fra1
S3_PUBLIC_BASE_URL=

UPLOAD_MAX_BYTES=6291456

# ── Google / Apple Sign-In ────────────────────────────────────────────────────
ENABLE_SOCIAL_LOGIN=true
GOOGLE_OAUTH_CLIENT_IDS=WEB_ID.apps.googleusercontent.com,ANDROID_ID.apps.googleusercontent.com,IOS_ID.apps.googleusercontent.com
APPLE_OAUTH_CLIENT_ID=com.sombateka.st
# Guide : mobile/docs/SOCIAL_AUTH_SETUP.md

# ── Monitoring ────────────────────────────────────────────────────────────────
# Créer un projet sur https://sentry.io → coller le DSN (active erreurs backend/celery)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Uptime : créer un check Healthchecks.io / UptimeRobot sur https://DOMAIN/healthz
# Après smoke test local, optionnel : $env:HEALTHCHECKS_PING_URL="https://hc-ping.com/UUID"

LOG_LEVEL=INFO
